# Files ignored by renv::dependencies() — and therefore by grateful::scan_packages().
# Add utility scripts here that reference packages NOT needed to render the book,
# so CI builds don't try to install them.

# Splits the rendered PDF into per-chapter PDFs. Uses pdftools, which we don't
# want to require on the CI runner (needs libpoppler-cpp-dev system library).
split_chapters.R
