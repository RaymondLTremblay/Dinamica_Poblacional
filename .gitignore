# =============================================
# Archive folder — local cleanup of unused assets, do not commit
# =============================================
_archive/

# =============================================
# Knitr / Quarto regenerable output
# =============================================
*_cache/                 # knitr cache (e.g. 107-matU_matF_matC_cache/)
*_files/                 # Quarto chunk-output folders (e.g. 105-Transiciones_files/)
file*/                   # leftover htmlwidgets temp folders (e.g. file10bbd7283e2ac/)
*.knit.md
*.utf8.md

# =============================================
# Quarto Build Outputs — NEVER commit these
# =============================================
_site/
/.quarto/
_freeze/

# =============================================
# R / RStudio
# =============================================
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj          # keep DinamicaPob.Rproj — remove this line if you want to track it

# renv — only lock file and .Rprofile belong in git
renv/library/
renv/local/
renv/cellar/
renv/staging/
renv/.gitignore

# =============================================
# macOS junk
# =============================================
.DS_Store
.AppleDouble
.LSOverrideDirectory
__MACOSX/

# =============================================
# Windows junk
# =============================================
Thumbs.db
ehthumbs.db
Desktop.ini

# =============================================
# Temp / cache files
# =============================================
*.log
*.aux
*.out
*.toc
*.lof
*.lot
*.idx
*.bbl
*.blg
*~
\#*\#
*.swp

# =============================================
# Typst intermediate (in case keep-typ is ever true)
# =============================================
*.typ

# =============================================
# Large data / sensitive files — adjust as needed
# =============================================
# data/raw/
# *.csv         # uncomment if raw data should stay local

# =============================================
# Quarto additional build artifacts
# =============================================
.quarto/
docs/
*.tiff
*.tif

# =============================================
# Large data / session files
# =============================================
*.RData
*.Rhistory
COMPADRE_June.RData

# =============================================
# Conflicted copies (Dropbox/Syncthing)
# =============================================
*conflicted copy*

# =============================================
# Loose web verification / meta files
# =============================================
# google*.html  # removed — needed for Google Search Console verification
meta.html
meta.html.Rhtml
sitemap.xml

**/*.quarto_ipynb
.positai

# =============================================
# Editor agent working directories — never commit
# =============================================
.claude/

