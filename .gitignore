# NOTE: .gitignore does NOT support trailing inline comments.
# A "#" mid-line becomes part of the pattern. Keep comments on their own lines.

# Archive folder — local quarantine of unused assets, do not commit
_archive/

# Knitr / Quarto regenerable output
*_cache/
*_files/
file[0-9a-f]*
*.knit.md
*.utf8.md

# Quarto build outputs — never commit
_site/
/.quarto/
.quarto/
_freeze/
docs/

# R / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata
COMPADRE_June.RData
# Keep the project file tracked
*.Rproj
!DinamicaPob.Rproj

# renv (only lockfile + .Rprofile belong in git)
renv/library/
renv/local/
renv/cellar/
renv/staging/
renv/.gitignore

# macOS / Windows junk
.DS_Store
.AppleDouble
.LSOverrideDirectory
__MACOSX/
Thumbs.db
ehthumbs.db
Desktop.ini
.fuse_hidden*

# Temp / cache / TeX intermediates
*.log
*.aux
*.out
*.toc
*.lof
*.lot
*.idx
*.bbl
*.blg
*~
\#*\#
*.swp
*.typ
/index.tex

# Images that are render scratch, not source
*.tiff
*.tif

# Dropbox / Syncthing conflicted copies
*conflicted copy*

# Loose web/meta files (book renders into docs/, not root)
meta.html
meta.html.Rhtml
sitemap.xml
/1[0-9][0-9]*.html
/index.html
/404.html

# Per-chapter Word output (regenerable via render_docx_per_chapter.R)
docx_chapters/

# One-shot tooling / experiment outputs
captions_*.json
palette_*.pdf
compare_palettes.html
compare_palettes_files/

# Jupyter / misc
**/*.quarto_ipynb
.positai

# Editor agent working directories — never commit
.claude/
