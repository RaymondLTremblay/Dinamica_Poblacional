# =============================================
# Quarto Build Outputs — NEVER commit these
# =============================================
_site/
/.quarto/

# =============================================
# R / RStudio
# =============================================
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj          # keep DinamicaPob.Rproj — remove this line if you want to track it

# renv — only lock file and .Rprofile belong in git
renv/library/
renv/local/
renv/cellar/
renv/staging/
renv/.gitignore

# =============================================
# macOS junk
# =============================================
.DS_Store
.AppleDouble
.LSOverrideDirectory
__MACOSX/

# =============================================
# Windows junk
# =============================================
Thumbs.db
ehthumbs.db
Desktop.ini

# =============================================
# Temp / cache files
# =============================================
*.log
*.aux
*.out
*.toc
*~
\#*\#
*.swp

# =============================================
# Large data / sensitive files — adjust as needed
# =============================================
# data/raw/
# *.csv         # uncomment if raw data should stay local

# =============================================
# Quarto additional build artifacts
# =============================================
.quarto/
docs/
*.tiff
*.tif

# =============================================
# Large data / session files
# =============================================
*.RData
*.Rhistory
COMPADRE_June.RData

# =============================================
# Conflicted copies (Dropbox/Syncthing)
# =============================================
*conflicted copy*

# =============================================
# Loose web verification / meta files
